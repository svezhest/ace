{
  "name": "think27t",
  "doc": "Как think27 (Qwen 27B с рассуждением, шлюз 8091), но temperature 0.6: ответы не детерминированы — для развилок по нескольку ответов. Драфтер при T≠0 не работает. Проба docs/lab/1112/HT-think-at-decision.md.",
  "model": "qwen38-27b",
  "served_model": "qwen38-27b-mlx-5bit",
  "worker": {
    "port": 50051,
    "count": 1,
    "env": {
      "QWEN_MODEL": "../../weights/qwen38-27b-mlx-5bit",
      "QWEN_KV_BITS": "0",
      "QWEN_MRQMM5": "1",
      "QWEN_DRAFT": "../../weights/qwen38-27b-dflash2",
      "QWEN_MAX_BATCH": "1",
      "QWEN_MAX_CONTEXT": "65536",
      "QWEN_PROMPT_CACHE": "1",
      "QWEN_PROMPT_CACHE_MOVE": "1",
      "QWEN_PROMPT_CACHE_GB": "3",
      "QWEN_PROMPT_CACHE_CKPTS": "4",
      "QWEN_WIRED_LIMIT_GB": "27",
      "QWEN_CACHE_LIMIT_GB": "1",
      "QWEN_SDPA_FUSED_MIN_KV": "8192",
      "QWEN_PREFILL_BUDGET": "16777216",
      "QWEN_PRESENCE_PENALTY": "0",
      "QWEN_BATCH_MEM_GB": "3.2"
    }
  },
  "gateways": {
    "think": {
      "port": 8091,
      "cmd": "./target/release/qwen-gateway",
      "env": {
        "GATEWAY_ADDR": "127.0.0.1:8091",
        "GATEWAY_SERVED_MODEL_NAMES": "qwen38-27b"
      },
      "thinking": true
    }
  },
  "agent": {
    "gateway": "think",
    "temperature": 0.6,
    "max_tokens": 8192,
    "thinking": true,
    "think_budget": 4096
  }
}
