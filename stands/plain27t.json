{
  "name": "plain27t",
  "doc": "Как plain27 (Qwen 27B без рассуждения, шлюз 8092), но temperature 0.6 — как у писателя на 9B. Драфтер при T≠0 не работает; сессия не детерминирована. Проба docs/lab/1111/PT-27b-plain-temp06.md.",
  "model": "qwen38-27b",
  "served_model": "qwen38-27b-mlx-5bit",
  "worker": {
    "port": 50051,
    "count": 1,
    "env": {
      "QWEN_MODEL": "../../weights/qwen38-27b-mlx-5bit",
      "QWEN_KV_BITS": "0",
      "QWEN_MRQMM5": "1",
      "QWEN_DRAFT": "../../weights/qwen38-27b-dflash2",
      "QWEN_MAX_BATCH": "1",
      "QWEN_MAX_CONTEXT": "65536",
      "QWEN_PROMPT_CACHE": "1",
      "QWEN_PROMPT_CACHE_MOVE": "1",
      "QWEN_PROMPT_CACHE_GB": "3",
      "QWEN_PROMPT_CACHE_CKPTS": "4",
      "QWEN_WIRED_LIMIT_GB": "27",
      "QWEN_CACHE_LIMIT_GB": "1",
      "QWEN_SDPA_FUSED_MIN_KV": "8192",
      "QWEN_PREFILL_BUDGET": "16777216",
      "QWEN_PRESENCE_PENALTY": "0",
      "QWEN_BATCH_MEM_GB": "3.2"
    }
  },
  "gateways": {
    "main": {
      "port": 8092,
      "cmd": "./target/release/qwen-gateway",
      "env": {
        "GATEWAY_ADDR": "127.0.0.1:8092",
        "GATEWAY_THINKING": "off",
        "GATEWAY_SERVED_MODEL_NAMES": "qwen38-27b"
      },
      "thinking": false
    }
  },
  "agent": {
    "gateway": "main",
    "temperature": 0.6,
    "max_tokens": 8192,
    "thinking": false,
    "think_budget": null
  }
}
