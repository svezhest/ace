# Test all combinations of operators for: 8 ? 3 ? 20 ? 4 = -75
# Operators: +, -, *, /
# Following standard order of operations (PEMDAS)

def evaluate(a, b, c, d, op1, op2, op3):
    # Apply multiplication and division first (left to right), then +/-
    # Build the expression respecting precedence
    if op1 in ('*', '/') and op2 in ('*', '/') and op3 in ('*', '/'):
        # All multiplicative - evaluate left to right
        result = a
        result = result * b if op1 == '*' else result / b
        result = result * c if op2 == '*' else result / c
        result = result * d if op3 == '*' else result / d
        return result
    elif op1 in ('+', '-') and op2 in ('+', '-') and op3 in ('+', '-'):
        # All additive - evaluate left to right
        result = a
        result = result + b if op1 == '+' else result - b
        result = result + c if op2 == '+' else result - c
        result = result + d if op3 == '+' else result - d
        return result
    else:
        # Mixed: multiplicative operations bind tighter, so group them
        # First compute the "product/division" segments
        # Identify which positions are multiplicative
        # We evaluate by first handling * and / as they take precedence
        # Split into terms separated by + or -
        terms = []
        current = a
        for i, op in enumerate([op1, op2, op3]):
            if op in ('+', '-'):
