            result += [b, c, d][i]
        elif op == '-':
            result -= [b, c, d][i]
        elif op == '*':
            result *= [b, c, d][i]
        elif op == '/':
            result /= [b, c, d][i]
    
    if result == target:
        solutions.append(ops)
```
