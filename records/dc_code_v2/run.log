[Use a reusable template for missing-operator puzzles that handles arbitrary numbers of blanks, uses exact fraction arithmetic, guards against division by zero, and reports all solutions. This template can be adapted for any similar puzzle by changing the numbers, target, and number of blanks.](Reference: Q2, Q3, Q4)
</description>
<example>
```python
from itertools import product
from fractions import Fraction

def solve_missing_operators(numbers, target):
    operators = ['+', '-', '*', '/']
    n = len(numbers) - 1
    solutions = []
    
    for ops in product(operators, repeat=n):
        result = Fraction(numbers[0])
        for i, op in enumerate(ops):
            operand = Fraction(numbers[i + 1])
            if op == '+':
                result += operand
            elif op == '-':
                result -= operand
            elif op == '*':
                result *= operand
            elif op == '/':
                if operand == 0:  # Guard against division by zero
                    continue
                result /= operand
        
        if result == Fraction(target):
            expr = " ".join(str(numbers[i]) + " " + ops[i] for i in range(n))
            solutions.append(f"{' '.join(map(str, numbers))} = {target}")
    
    return solutions

# Example usage:
print(solve_missing_operators([28, 15, 22], 9240))
# Output: ['28 * 15 * 22 = 9240']
```
</example>
</memory_item>

