For an equation with 3 blanks (a ? b ? c ? d = target):
```python
from itertools import product

operators = ['+', '-', '*', '/']
solutions = []

for ops in product(operators, repeat=3):
    a, b, c, d = 10, 6, 21, 4  # example values
    # Evaluate left to right
    result = a
    for i, op in enumerate(ops):
