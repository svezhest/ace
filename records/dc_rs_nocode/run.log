from itertools import product

operators = ['+', '-', '*', '/']
numbers = [15, 19, 8, 2, 24]
target = 42

def evaluate(nums, ops):
    # Respect operator precedence: * and / first, then + and -
    # Split into precedence groups
    tokens = []
    for i, (n, op) in enumerate(zip(nums, ops)):
        tokens.append((n, op))
    # Evaluate * and / first
    result = tokens[0][0]
    i = 0
    while i < len(tokens):
        if tokens[i][1] in ('*', '/'):
            nxt = tokens[i+1]
            if nxt[1] == '*':
                result *= nxt[0]
            else:
                result /= nxt[0]
            i += 2
        else:
            i += 1
    # Now handle + and - left to right
    while i < len(tokens):
        if tokens[i][1] == '+':
            result += tokens[i][0]
        else:
            result -= tokens[i][0]
        i += 1
    return result

solutions = []
for ops in product(operators, repeat=len(numbers)-1):
    try:
        val = evaluate(numbers, ops)
        if abs(val - target) < 1e-9:
            solutions.append((ops, val))
    except (ZeroDivisionError, ValueError):
        continue

print("Solutions:", solutions)
```
