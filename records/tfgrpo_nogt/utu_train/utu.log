ist(range(1, n+1))\n    total = sum(piles)\n    max_t = 0\n    argmax = None\n    for k in range(1, total+1):\n        t = bfs_min_turns(k, list(range(1,n+1)))\n        if t is None:\n            print(f\"  ERROR k={k}: returned None\")\n            break\n        if t > max_t:\n            max_t = t\n            argmax = k\n    print(f\"  n={n}: max min_turns = {max_t} at k={argmax}\")"}) - MainThread
