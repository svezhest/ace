ltinom\n    subtotal = room_choice * total_ways\n    total += subtotal\n    print(f\"k={k}: #compositions={len(comps)}, room_choice={room_choice}, subtotal={subtotal}\")\n\nprint(\"Total:\", total)"}) - MainThread
