simp=simp[order]; continue\n        simp=simp[0:1]+alpha*(simp.sum(0)-simp[0:1]); fvals[0]=obj(simp[0,0],simp[0,1])\n        order=np.argsort(fvals); simp=simp[order]\n        if (fvals[0]-fvals[1])<fatol*abs(fvals[1])+fatol and np.ptp(simp)<xatol*np.mean(np.abs(simp.sum(0))):\n            break\n    order=np.argsort(fvals); return simp[order[0]]\n\nbest=-1;bestp=None\nrng=np.random.default_rng(1)\nfor trial in range(5000):\n    th=rng.uniform(0,2*np.pi); ph=rng.uniform(0,2*np.pi)\n    B=np.array([R*np.cos(th),R*np.sin(th)]); d1=(A-B)/ab2(B); d2=A-B\n    C=np.array([R*np.cos(ph),R*np.sin(ph)]); d3=(A-C)/ac2(C); d4=A-C\n    p0=[th,ph] if (d1@d2+d3@d4)>1e-9 else [th+0.3,ph+0.7]\n    r=nelder_mead(obj,p0)\n    if -r[0]>best: best=-r[0];bestp=r\n\nth,ph=bestp\nB=np.array([R*np.cos(th),R*np.sin(th)]); C=np.array([R*np.cos(ph),R*np.sin(ph)])\nap2=ab2(B); ac2p=ac2(C); bc2p=bc2(B,C)\nangleBAC=np.arccos((ap2+ac2p-bc2p)/(2*np.sqrt(ap2*ac2p)))\nleg=np.sqrt(bc2p); h=leg*np.sin(angleBAC)\nprint(\"B=\",B,\"C=\",C)\nprint(\"Area max =\",best)\nprint(\"angleBAC(deg)=\",np.degrees(angleBAC))\nprint(\"leg=\",np.sqrt(bc2p),\"h=\",h,\"ab2=\",ap2,\"ac2=\",ac2p)"}) - MainThread
