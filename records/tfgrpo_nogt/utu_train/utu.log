ce we go from small size, first found is answer\n                # but need to check all of this size\n                pass\n        # Actually since we want min size, and for a given size the range is contiguous,\n        # we can break early if found. But combinations order isn't sorted by size.\n        # Let me restructure.\n    return best\n\n# Better: go by size ascending\ndef exhaustive_min_turns2(k, piles):\n    piles = sorted(piles)\n    for size in range(1, len(piles)+1):\n        for S in combinations(range(len(piles)), size):\n            chosen = [piles[i] for i in S]\n            min_sum = size  # each pile at least 1\n            max_sum = sum(chosen)\n            if min_sum <= k <= max_sum:\n                return size\n    return None\n\n# Verify\nfor n in [3, 4, 5, 6]:\n    piles = list(range(1, n+1))\n    total = sum(piles)\n    ok = True\n    for k in range(1, total+1):\n        e = exhaustive_min_turns2(k, piles)\n        f = formula_min_turns(k, n)\n        if e != f:\n            ok = False\n            print(f\"n={n}, k={k}: exhaustive={e}, formula={f}\")\n            break\n    print(f\"n={n}: exhaustive matches formula? {ok}\")\n\n# Max over k\nprint(\"\\nMax min_turns:\")\nfor n in [3, 4, 5, 10, 20]:\n    piles = list(range(1, n+1))\n    total = sum(piles)\n    max_t = max(exhaustive_min_turns2(k, piles) for k in range(1, total+1))\n    print(f\"  n={n}: max = {max_t} at k={total}\")"}) - MainThread
