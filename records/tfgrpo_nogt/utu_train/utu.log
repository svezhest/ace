2026-01-01 00:00:00,000[utu.hooks.base_hooks] - DEBUG - base_hooks.py:41 - [toolcall-call_93b8ff0776f045258b0fe5a8] execute_python_code({"code": "import numpy as np\nfrom scipy.optimize import minimize\n\nA=np.array([0.0,3.0]); R=5.0\ndef ab2(B): return float(np.dot(A-B,A-B))\ndef ac2(C): return float(np.dot(A-C,A-C))\ndef bc2(B,C): return float(np.dot(B-C,B-C))\n\n# params: theta (B angle), phi (C angle). Right-angle constraint enforced softly.\ndef area(th,ph):\n    B=np.array([R*np.cos(th),R*np.sin(th)]); C=np.array([R*np.cos(ph),R*np.sin(ph)])\n    return 0.25*bc2(B,C)*(ab2(B)+ac2(C)-bc2(B,C))\n\ndef rightang_penalty(th,ph):\n    B=np.array([R*np.cos(th),R*np.sin(th)]); C=np.array([R*np.cos(ph),R*np.sin(ph)])\n    return (ab2(B)+ac2(C)-bc2(B,C))**2\n\ndef obj(th,ph,w=1.0):\n    return -area(th,ph)+w*rightang_penalty(th,ph)\n\ndef grad(th,ph,w=1.0):\n    thp=th+1e-6; php=ph+1e-6\n    dth=(obj(thp,ph,w)-obj(th,ph,w))/1e-6\n    dph=(obj(th,php,w)-obj(th,ph,w))/1e-6\n    return np.array([dth,dph])\n\nbest=-1;bestp=None\nrng=np.random.default_rng(1)\nfor trial in range(2000):\n    th=rng.uniform(0,2*np.pi); ph=rng.uniform(0,2*np.pi)\n    # init on right-angle curve\n    B=np.array([R*np.cos(th),R*np.sin(th)])\n    d1=(A-B)/ab2(B); d2=A-B\n    C=np.array([R*np.cos(ph),R*np.sin(ph)])\n    d3=(A-C)/ac2(C); d4=A-C\n    if d1@d2+d3@d4>1e-9:\n        p0=[th,ph]\n    else:\n        p0=[th+0.3,ph+0.7]\n    res=minimize(obj,p0,jac=grad,method='Nelder-Mead',options={'maxiter':20000,'xatol':1e-11,'fatol':1e-13})\n    if -res.fun>best:\n        best=-res.fun;bestp=res.x\n\nth,ph=bestp\nB=np.array([R*np.cos(th),R*np.sin(th)]); C=np.array([R*np.cos(ph),R*np.sin(ph)])\nap2=ab2(B); ac2p=ac2(C); bc2p=bc2(B,C)\nangleBAC=np.arccos((ap2+ac2p-bc2p)/(2*np.sqrt(ap2*ac2p)))\nleg=np.sqrt(bc2p); h=leg*np.sin(angleBAC)\nprint(\"B=\",B,\"C=\",C)\nprint(\"Area max ≈\",best)\nprint(\"angleBAC(deg)=\",np.degrees(angleBAC))\nprint(\"leg=\",np.sqrt(bc2p),\"h=\",h)\nprint(\"ab2=\",ap2,\"ac2=\",ac2p)"}) - MainThread
