fy the general formula.\n# The line through E and center O=(2.5,6).\n# E=(1,-12). \n# F on AB (y=0): F=(2,0). G on CD (y=12): G=(3,12).\n# FG^2 = (3-2)^2+(12)^2 = 1+144 = 145.\nprint(\"F=(2,0), G=(3,12), FG^2=145\")\n\n# Verify E's distances:\nprint(\"dist E to AB (y=0):\",abs(-12),\"(should be 12)\")\nprint(\"dist E to AD (x=0):\",abs(1),\"(should be 1)\")"}) - MainThread
