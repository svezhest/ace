a = rng.uniform(0,2*np.pi)\n    area,B,C = area_angle(a)\n    if area>best:\n        best=area; bestcfg=(B.copy(),C.copy())\nprint(\"Numerical best area ~\", best)\nB,C=bestcfg\nprint(\"B=\",B,\"C=\",C)\nprint(\"BC=\",np.linalg.norm(B-C))\nprint(\"area via 0.5*BC*3 =\", 0.5*np.linalg.norm(B-C)*3)\nprint(\"24/5 =\", 24/5)"}) - MainThread
