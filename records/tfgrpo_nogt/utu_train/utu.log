h/y).\n# If theta=10 deg is at the START (y=d), then h = d*tan(10) = 0.1763 m.\n# As block moves toward pulley (y decreases), theta INCREASES.\n\n# Let me set up this geometry and integrate.\nh = d*np.tan(10*np.pi/180)  # pulley height\nprint(\"Pulley height h =\", h, \"m\")\n\ndef accel_y(y):\n    # rope length to block = sqrt(y^2+h^2)\n    rope = np.sqrt(y**2 + h**2)\n    theta = np.arctan(h/y)\n    c, s = np.cos(theta), np.sin(theta)\n    a = g*(M*(c+mu*s) - mu*m)/(m + M*(c+mu*s))\n    return a  # acceleration toward pulley (increasing speed toward pulley)\n\n# y decreases from d to 0. Time = integral of dy/|v|.\n# Use energy or just integrate dv/dt with v = dx/dt.\n# Since a = dv/dt and v = dy/dt (y decreasing, v>0 speed), and a depends on y:\n# We have dv/dt = a(y), and dy/dt = -v.\n# So dv/dy * dy/dt = a(y) => dv/dy * (-v) = a(y) => v dv/dy = -a(y)\n# v dv = -a(y) dy  (dy negative as y decreases)\n# Integrate from y=d (v=0) to y=0:\n# (1/2)v^2 = -integral_d^0 a(y) dy = integral_0^d a(y) dy\nv_final_sq = integrate.quad(lambda y: accel_y(y), 0, d)[0]\nv_final = np.sqrt(v_final_sq)\nprint(\"v_final =\", v_final, \"m/s\")\nprint(\"But this gives variable acceleration, not constant...\")\n\n# Actually, let me reconsider. The problem says CONSTANT angle, so acceleration is constant.\n# Let me just confirm the constant-angle answer is the intended one.\na_const = accel_y(d)\nprint(\"Constant-angle acceleration =\", a_const, \"m/s^2\")\nt = np.sqrt(2*d/a_const)\nprint(\"Constant-angle time t =\", t, \"s, 100t =\", 100*t)"}) - MainThread
