2026-01-01 00:00:00,000[utu.hooks.base_hooks] - DEBUG - base_hooks.py:41 - [toolcall-call_0315a318af20460381e09c45] execute_python_code({"code": "import numpy as np\nimport math\n\ndef solve_triangle(A_deg, B_deg, C_deg):\n    A = math.radians(A_deg); B = math.radians(B_deg); C = math.radians(C_deg)\n    # Place B at origin, C on positive x-axis\n    a_side = 1.0  # BC\n    # angle at B\n    x_A = a_side * math.cos(B); y_A = a_side * math.sin(B)\n    # C at (a_side, 0)\n    Cx, Cy = a_side, 0.0\n    # angle at C\n    x_A2 = Cx - a_side * math.cos(math.pi - C); y_A2 = a_side * math.sin(math.pi - C)\n    # Verify A\n    # Exterior angle bisector at B: direction bisects exterior angle.\n    # Interior bisector at B points toward A: dir = (x_A, y_A)/|...|\n    # Exterior bisector is perpendicular to interior bisector.\n    def unit(v):\n        n = math.hypot(*v); return (v[0]/n, v[1]/n)\n    dBA = unit((x_A - 0, y_A - 0))  # from B toward A\n    # interior bisector at B direction dBA\n    # exterior bisector perpendicular: rotate 90 deg\n    intB = dBA\n    extB = (-intB[1], intB[0])\n    dCA = unit((x_A2 - Cx, y_A2 - Cy))  # from C toward A\n    intC = dCA\n    extC = (-intC[1], intC[0])\n    # Ray from B: B + t*extB ; Ray from C: C + s*extC\n    # Solve for intersection D\n    # t*extB - s*extC = C - B\n    ex, ey = extB; fx, fy = extC; gx, gy = Cx - 0, Cy - 0\n    det = ex*fy - fx*ey\n    t = (gx*fy - fx*gy)/det\n    Dx = 0 + t*ex; Dy = 0 + t*ey\n    return (Dx, Dy)\n\nfor (A,B,C) in [(60,60,60),(80,60,40),(90,50,40),(30,100,50)]:\n    Dx,Dy = solve_triangle(A,B,C)\n    # angle BDC\n    B=(0,0); C=(1,0)\n    v1=(B[0]-Dx,B[1]-Dy); v2=(C[0]-Dx,C[1]-Dy)\n    c1=math.hypot(*v1); c2=math.hypot(*v2)\n    dot=v1[0]*v2[0]+v1[1]*v2[1]\n    ang=math.degrees(math.acos(max(-1,min(1,dot/(c1*c2)))))\n    predicted = 90 - A/2\n    print(f\"A={A}: angle BDC (numeric)={ang:.3f}, predicted 90-A/2={predicted:.3f}\")"}) - MainThread
