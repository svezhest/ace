a,b,B,C = max_ab\nprint(\"a=%.5f b=%.5f\" % (a,b))\nprint(\"B =\", B, \" C =\", C)\nAB=B-A; AC=C-A\nprint(\"AB.AC =\", AB.dot(AC), \" angle(deg)=\", math.degrees(math.acos(max(dot(AB,AC),-1)/min(np.linalg.norm(AB),np.linalg.norm(AC))))\nprint(\"Area = 0.5*|AB x AC| =\", area)\nprint(\"t=|AB|-|AC| =\", np.linalg.norm(AB)-np.linalg.norm(AC))\nprint(\"Area = 25 - t^2/4 =\", 25 - ((np.linalg.norm(AB)-np.linalg.norm(AC))**2)/4)"}) - MainThread
