rns).\n#    Wait, you could touch the same pile twice but that only wastes a turn.\n#    So in m turns, you remove from at most m distinct piles, total <= sum of those m piles\n#    <= sum of m largest. So k <= sum of m largest. Hence m turns requires k <= sum of m largest.\n#  - Therefore min_turns(k) = smallest m with sum of m largest >= k. CONFIRMED.\n\n# Let me just do a careful BFS for n=3 to be 100% sure.\nfrom collections import deque\n\ndef bfs_min_turns(k, piles):\n    # BFS over state = tuple of remaining coins\n    start = tuple(piles)\n    if start[0] == k or start[1] == k or start[2] == k:  # can remove all k from one pile\n        # more generally\n    visited = set([start])\n    queue = deque([(start, 0)])\n    while queue:\n        state, turns = queue.popleft()\n        if sum(state) < k:\n            continue\n        if sum(state) == k:\n            return turns  # all removed\n        for i in range(len(state)):\n            for amt in range(1, state[i]+1):\n                new_state = list(state)\n                new_state[i] -= amt\n                ns = tuple(new_state)\n                if ns not in visited and sum(ns) >= 0:\n                    visited.add(ns)\n                    queue.append((ns, turns+1))\n    return None\n\n# Test n=3\npiles3 = [1,2,3]\nfor k in range(1, 7):\n    result = bfs_min_turns(k, piles3)\n    # formula\n    m = 1\n    while True:\n        s = m*3 - m*(m-1)//2\n        if s >= k:\n            break\n        m += 1\n    formula = m\n    print(f\"n=3, k={k}: BFS={result}, formula={formula}, match={result==formula}\")"}) - MainThread
