.0,3.0])\ndef dot(u,v): return u[0]*v[0]+u[1]*v[1]\n\n# Find ONE valid config by direct scan\nfound=None\nfor a in np.linspace(0,2*math.pi,900):\n    B=pt(a); AB=B-A; uA=dot(AB,A)\n    rhs=uA/(5*math.hypot(AB[0],AB[1]))\n    if abs(rhs)>1: continue\n    dab=math.acos(rhs); phi=math.atan2(AB[1],AB[0])\n    for s in(+1,-1):\n        for k in range(-3,4):\n            b=(phi+s*dab+2*k*math.pi)%(2*math.pi)\n            C=pt(b); AC=C-A\n            if abs(dot(AB,AC))<1e-3:\n                found=(a,b,B.copy(),C.copy()); break\n        if found: break\n    if found: break\n\na,b,B,C=found\nAB=B-A; AC=C-A\nOM=(B+C)/2\nprint(\"Found config: a=%.4f b=%.4f\" % (a,b))\nprint(\"B=\",B,\" C=\",C)\nprint(\"AB.AC=\",dot(AB,AC),\" (≈0 means 90°)\")\nprint(\"Area =\",0.5*abs(AB[0]*AC[1]-AB[1]*AC[0]))\nprint(\"OM=\",OM,\" OM^2=\",OM[0]**2+OM[1]**2)\nt=math.hypot(AB[0],AB[1])-math.hypot(AC[0],AC[1])\nprint(\"t=|AB|-|AC|=\",t)\nprint(\"Formula t^2=4(OM^2-9)/OM^2 =\", math.sqrt(4*(OM[0]**2+OM[1]**2-9)/(OM[0]**2+OM[1]**2)))\nprint(\"t^2 actual =\", t**2)"}) - MainThread
