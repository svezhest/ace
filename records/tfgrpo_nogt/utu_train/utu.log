    visited_scc.add(u); order.append(u)\n    for v in sorted(cond_adj[u]):\n        if v not in visited_scc:\n            cond_dfs(v)\ncond_dfs(15)\ntrans_ok = all(any(t in cond_adj[s] for t in cond_adj[s]) for s, t in zip(order, order[1:]))\nprint(\"Consecutive SCC transitions valid?\", trans_ok)\n\ndef scc_vertices(s):\n    return [v for v in range(m) if scc_id[v]==s]\n\ndef spanning_walk_from_to(comp, entry, exit_v):\n    comp_set = set(comp)\n    seq = [entry]\n    vis = {entry}\n    def dfs(u):\n        for w in adj[u]:\n            if w in comp_set and w not in vis:\n                vis.add(w); seq.append(w)\n                dfs(w)\n    dfs(entry)\n    if seq[-1] == exit_v:\n        return seq\n    prev = {seq[-1]: None}\n    dq = deque([seq[-1]])\n    while dq:\n        u = dq.popleft()\n        if u == exit_v: break\n        for w in adj[u]:\n            if w in comp_set and w not in prev:\n                prev[w] = u; dq.append(w)\n    path = []\n    x = exit_v\n    while x is not None:\n        path.append(x); x = prev[x]\n    path.reverse()\n    seq.extend(path[1:])\n    return seq\n\nfull = []\nfor idx, s in enumerate(order):\n    comp = scc_vertices(s)\n    entry = comp[0]\n    if idx < len(order)-1:\n        t = order[idx+1]\n        exits = [u for u in comp for w in adj[u] if scc_id[w]==t]\n        exit_v = exits[0]\n    else:\n        exit_v = comp[0]\n    walk = spanning_walk_from_to(comp, entry, exit_v)\n    full.extend(walk)\n\ndistinct = sorted(set(full))\nprint(\"Walk length:\", len(full), \"Distinct:\", len(distinct))\nprint(\"Covers all 210?\", len(distinct)==210)\n\ndef valid_walk(walk):\n    for i in range(len(walk)-1):\n        if not divides(gcd(walk[i], m), walk[i+1]):\n            return False, (walk[i], walk[i+1])\n    return True, None\nok, bad = valid_walk(full)\nprint(\"Walk valid?\", ok, \"bad edge:\", bad)\n\n# Now construct actual integers a_i and verify.\ndistinct_seq = distinct\na = []\nfor i, b in enumerate(distinct_seq):\n    if i == 0:\n        rep = b if b != 0 else 210\n        a.append(rep)\n    else:\n        prev = a[-1]; target = b\n        g = gcd(prev, m)\n        assert target % g == 0, (prev, target, g)\n        mod = m // g\n        p = prev // g; t = target // g\n        inv = pow(p, -1, mod)\n        k = (t * inv) % mod\n        a.append(prev * k)\n\ndef check(a_seq):\n    bs = [x % m for x in a_seq]\n    assert bs == distinct_seq, \"b_i mismatch!\"\n    for i in range(len(a_seq)-1):\n        assert a_seq[i] != 0 and a_seq[i+1] % a_seq[i] == 0, (\"div fail\", a_seq[i], a_seq[i+1])\n    return True\ncheck(a)\nprint(\"Construction verified! a_i | a_{i+1} for all i, b_i = a_i mod 210 = distinct_seq.\")\nprint(\"Number of distinct terms:\", len(distinct))"}) - MainThread
