2026-01-01 00:00:00,000[utu.hooks.base_hooks] - DEBUG - base_hooks.py:41 - [toolcall-call_15dc4991347c4ba18e19626b] execute_python_code({"code": "import numpy as np\n\n# Set up rectangle ABCD\n# A at origin, AB along x-axis, AD along y-axis\nA = np.array([0,0])\nB = np.array([5,0])\nD = np.array([0,12])\nC = np.array([5,12])\nprint(\"AB = \", np.linalg.norm(B-A), \" AD =\", np.linalg.norm(D-A))\n\n# Find E: perpendicular distance to line AB (x-axis) is 12, to line AD (y-axis) is 1\n# Below analysis: E = (1,12) gives distances 12 and 1, and triangle ABE is acute.\n# Check all four candidates\nfor (ex,ey) in [(1,12),(1,-12),(-1,12),(-1,-12)]:\n    E = np.array([ex,ey])\n    # distances\n    dAB = abs(E[1]); dAD = abs(E[0])\n    # side lengths\n    a = np.linalg.norm(E-A); b = np.linalg.norm(E-B); c = np.linalg.norm(A-B)\n    # angles\n    cosA = (a**2+b**2-c**2)/(2*a*b); cosB=(a**2+c**2-b**2)/(2*a*c); cosE=(b**2+c**2-a**2)/(2*b*c)\n    acute = (cosA>0 and cosB>0 and cosE>0)\n    print(f\"E=({ex},{ey}): dAB={dAB}, dAD={dAD}, acute={acute}, angles={np.degrees([cosA,cosB,cosE])}\")"}) - MainThread
