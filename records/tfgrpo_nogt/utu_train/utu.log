es\nA = sp.Matrix([0, 0])\nB = sp.Matrix([s, 0])\nC = sp.Matrix([0, s])\nD = sp.Matrix([AD_val, 0])\nE = sp.Matrix([0, AE_val])\n\ndef foot_of_perp(P, Q, R):\n    v = R - Q\n    t = (P - Q).dot(v) / (v.dot(v))\n    return Q + t*v\n\nX = foot_of_perp(D, B, C)\nY = foot_of_perp(E, B, C)\n\nXY_squared = sp.simplify((X - Y).dot(X - Y))\nprint(\"\\nXY² as function of s:\")\nprint(sp.expand(XY_squared))"}) - MainThread
