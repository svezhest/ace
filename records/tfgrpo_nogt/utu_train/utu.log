")\n\ndef brute_min_turns_fixed(k, piles):\n    piles = list(piles)\n    best = float('inf')\n    def rec(remaining, state):\n        nonlocal best\n        if remaining == 0:\n            best = min(best, len(state))\n            return\n        if remaining < 0 or len(state) >= best:\n            return\n        for i in range(len(piles)):\n            if piles[i] > 0:\n                for amt in range(1, piles[i]+1):\n                    if amt <= remaining:\n                        piles[i] -= amt\n                        state.append((i, amt))\n                        rec(remaining - amt, state)\n                        state.pop()\n                        piles[i] += amt\n    rec(k, [])\n    return best\n\n# Verify fixed brute force\nfor n in [3, 4, 5]:\n    piles = list(range(1, n+1))\n    total = sum(piles)\n    ok = True\n    for k in range(1, total+1):\n        b = brute_min_turns_fixed(k, list(piles))\n        f = formula_min_turns(k, n)\n        if b != f:\n            ok = False\n            print(f\"FIXED MISMATCH n={n}, k={k}: brute={b}, formula={f}\")\n            break\n    print(f\"n={n}: fixed brute matches formula? {ok}\")\n\n# Now recheck the max\nfor n in [3, 4, 5, 10]:\n    piles = list(range(1, n+1))\n    total = sum(piles)\n    max_t = max(brute_min_turns_fixed(k, list(piles)) for k in range(1, total+1))\n    print(f\"n={n}: max min_turns = {max_t}\")"}) - MainThread
