- mu*m)/(m + M*(c+mu*s))\nt2 = np.sqrt(2*d/a2)\nprint(\"With g=10: a=%.4f, t=%.4f, 100t=%.2f\" % (a2, t2, 100*t2))\n\n# What if the table block is NOT lifted off ground (N=mg)?\n#   a = g(M - mu*m)/(m+M) = 9.8*(2-0.5)/3 = 4.9\n# t = sqrt(2/4.9) = 0.639, 100t = 63.9\na3 = g*(M-mu*m)/(m+M)\nt3 = np.sqrt(2*d/a3)\nprint(\"With N=mg: a=%.4f, t=%.4f, 100t=%.2f\" % (a3, t3, 100*t3))\nwith g3=10.0:\n    a3b = 10*(M-mu*m)/(m+M)\n    t3b = np.sqrt(2*d/a3b)\n    print(\"With N=mg, g=10: a=%.4f, 100t=%.2f\" % (a3b, 100*t3b))"}) - MainThread
