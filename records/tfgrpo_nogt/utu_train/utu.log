t(25-OM^2)/5.\n#   So |AB|^2-|AC|^2 = -60*(5p/OM^2)*sqrt(25-OM^2)/5 = -60p*sqrt(25-OM^2)/OM^2.\n#   Also S^2 = |AB|^2+|AC|^2 + 2|AB||AC| = (68-300q/OM^2) + 2*(2*Area).\n#   And S*D = -60p*sqrt(25-OM^2)/OM^2.\n#   D=t. S = sqrt(|AB|^2+|AC|^2+4Area) = sqrt(68-300q/OM^2 + 8Area).\n#   t*S = -60p*sqrt(25-OM^2)/OM^2.\n#   Also Area = 25 - t^2/4 => t^2 = 100-4Area.\n#   This is getting complex. Let me just numerically find, for each feasible OM (with q given by formula),\n#   the actual area by constructing explicit points.\n\n# Simpler: for each candidate OM^2=r, q=(OM^2-8)*OM/8 (from constraint). \n# Then find a,b: cos((a+b)/2)=5p/OM^2, sin((a+b)/2)=5q/OM^2, cos((a-b)/2)=OM/5.\n# Choose p = OM (so (p,q) along a specific direction). Actually p can be anything with p^2+q^2=OM^2.\n# For area, only OM matters (Area=25-t^2/4, and t depends on OM). Let me verify t depends only on OM.\n\n# Let me just parametrize directly and compute area for the constraint-critical configs.\nimport numpy as np, math\ndef pt(t): return np.array([5*math.cos(t),5*math.sin(t)])\nAx,Ay=0.0,3.0\ndef dot(u,v): return u[0]*v[0]+u[1]*v[1]\n\n# For a given a, solve constraint for b EXACTLY and compute area.\n# Constraint: 25cos(a-b) -15(sin a+sin b)+9=0.\n# Solve for b: given a, this is f(b)=25cos(a-b)-15(sin a+sin b)+9=0.\n# Use the substitution: let me solve numerically (brentq) for each a, then compute area.\nfrom scipy.optimize import brentq\n\ndef f_of_b(a,b):\n    return 25*math.cos(a-b) -15*(math.sin(a)+math.sin(b)) +9\n\nmax_area=0; best=None\nfor a in np.linspace(0,2*math.pi,2000):\n    B=pt(a); AB=B-np.array([Ax,Ay])\n    # scan b for sign changes of f\n    bs=np.linspace(0,2*math.pi,20000)\n    fs=np.array([f_of_b(a,bt) for bt in bs])\n    sign=np.sign(fs)\n    changes=np.where(sign[1:]*sign[:-1]<0)[0]\n    for cc in changes:\n        lo,hi=bs[cc],bs[cc+1]\n        try:\n            b=brentq(f_of_b,a,lo,hi)\n        except Exception:\n            continue\n        C=pt(b); AC=C-np.array([Ax,Ay])\n        d=dot(AB,AC)\n        if abs(d)>1e-6: continue\n        area=0.5*abs(AB[0]*AC[1]-AB[1]*AC[0])\n        if area>max_area:\n            max_area=area; best=(a,b,B.copy(),C.copy())\n\nprint(\"Max area =\", max_area)\na,b,B,C=best\nAB=B-np.array([Ax,Ay]); AC=C-np.array([Ax,Ay])\nd=dot(AB,AC); norm=np.linalg.norm(AB)*np.linalg.norm(AC)\nprint(\"a=%.5f b=%.5f\" % (a,b))\nprint(\"B=\",B,\" C=\",C)\nprint(\"AB.AC=\",d,\" angle(deg)=\",math.degrees(math.acos(max(d/norm,-1))))\nprint(\"AB^2=\",np.linalg.norm(AB)**2,\" AC^2=\",np.linalg.norm(AC)**2)\nt=np.linalg.norm(AB)-np.linalg.norm(AC)\nprint(\"t=|AB|-|AC|=\",t,\" Area=25-t^2/4=\",25-t*t/4)\nOM=(B+C)/2\nprint(\"OM=\",OM,\" OM^2=\",OM[0]**2+OM[1]**2)"}) - MainThread
