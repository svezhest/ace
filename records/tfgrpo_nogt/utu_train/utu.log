 scratch with a clear free-body diagram.\nprint()\nprint(\"=\"*50)\nprint(\"CLEAR FREE-BODY DIAGRAM ANALYSIS:\")\nprint(\"=\"*50)\nprint(\"Table block (mass m=1):\")\nprint(\"  Forces along rope direction (toward pulley, +x):\")\nprint(\"    + T cos(theta)  [tension pulls toward pulley]\")\nprint(\"    - f = mu*N       [friction opposes motion]\")\nprint(\"  Forces perpendicular (vertical):\")\nprint(\"    + T sin(theta)  [tension has upward component]\")\nprint(\"    - mg            [gravity]\")\nprint(\"    + N             [normal force, up]\")\nprint(\"Hanging block (mass M=2):\")\nprint(\"  + M g  (down),  - T (up):  M g - T = M a (rises)\")\nprint()\nprint(\"Solving: a =\", aA if False else 9.8*(M*(c+mu*s)-mu*m)/(m+M*(c+mu*s)), \"m/s^2\")\nprint(\"t =\", np.sqrt(2*d/aA) if False else np.sqrt(2*d/(9.8*(M*(c+mu*s)-mu*m)/(m+M*(c+mu*s)))), \"s\")\nprint(\"100t =\", 100*np.sqrt(2*d/(9.8*(M*(c+mu*s)-mu*m)/(m+M*(c+mu*s)))), \"→ 2 sig figs\")"}) - MainThread
