2026-01-01 00:00:00,000[utu.hooks.base_hooks] - DEBUG - base_hooks.py:41 - [toolcall-call_26e3eb5f2535454a976d15ee] execute_python_code({"code": "import numpy as np\nfrom itertools import permutations\n\n# Try different orientations: A at origin, B and D from A, C=B+D\n# AB=5, AD=12. Try all assignments and sign combos for B, D\nconfigs=[]\nfor (bx,by) in [(5,0),(-5,0),(0,5),(0,-5)]:\n    for (dx,dy) in [(0,12),(0,-12),(12,0),(-12,0)]:\n        B=np.array([bx,by]); D=np.array([dx,dy]); A=np.array([0,0]); C=B+D\n        configs.append((A,B,C,D))\n\nfor (A,B,C,D) in configs:\n    # E candidates: distance to line AB =12, to line AD =1\n    def line_dist(P, L1, L2):\n        # line through L1, L2\n        d=np.cross(L2-L1, L1-P)\n        return abs(d)/np.linalg.norm(L2-L1)\n    cands=set()\n    # perpendicular from E to AB has length 12, to AD length 1\n    # E = foot_on_AB + 12*n1 = foot_on_AD + 1*n2\n    # For each combination of side directions\n    def normalize(v): return v/np.linalg.norm(v)\n    uAB=normalize(B-A); uAD=normalize(D-A)\n    n1=np.array([-uAB[1],uAB[0]]); n2=np.array([-uAD[1],uAD[0]])\n    for s1 in [1,-1]:\n        for s2 in [1,-1]:\n            # E = A + t1*uAB + s1*12*n1 = A + t2*uAD + s2*1*n2\n            # t1*uAB - 12*s1*n1 = t2*uAD - s2*n2\n            M=np.column_stack([uAB,-uAD])\n            rhs=np.array([s1*12*n1-s2*n2])\n            t=np.linalg.solve(M,rhs)\n            E=A+t[0]*uAB+s1*12*n1\n            # check acute ABE\n            a=np.linalg.norm(E-A);b=np.linalg.norm(E-B);c=np.linalg.norm(A-B)\n            cosA=(a**2+b**2-c**2)/(2*a*b);cosB=(a**2+c**2-b**2)/(2*a*c);cosE=(b**2+c**2-a**2)/(2*b*c)\n            acute=(cosA>0 and cosB>0 and cosE>0)\n            if acute:\n                cands.add(tuple(np.round(E,3)))\n    print(A,B,C,D,\"->\",\"E=\",cands)"}) - MainThread
