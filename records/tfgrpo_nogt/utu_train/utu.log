 abs(math.cos(a+math.acos(3*ca/5)/2))**2)*(25-9*ca*ca))\nprint(\"Area = 25 - t^2/4 =\", round(area,6))\n\n# Compare achievable 17\nprint(\"\\nAchievable (M=O) area = 17.\")\nprint(\"So max area =\", area, \"is the true maximum.\" if area < 17 else \"17 is larger!\")"}) - MainThread
