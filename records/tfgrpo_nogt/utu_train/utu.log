2026-01-01 00:00:00,000[utu.hooks.base_hooks] - DEBUG - base_hooks.py:41 - [toolcall-call_df9701ed352747debd51267d] execute_python_code({"code": "import sympy as sp\n\n# Set up the geometry\n# Triangle ABC with angles A, B, C\n# I'll derive the formula for angle BDC where D is the intersection of\n# exterior angle bisectors at B and C.\n\n# Method 1: Direct derivation using exterior angle bisector directions\n# At vertex B, the exterior angle is (180° - B). The exterior angle bisector\n# makes an angle of (180° - B)/2 with side BC, measured outward.\n#\n# In triangle DBC:\n# The exterior bisector at B bisects the angle formed by side BC and the\n# extension of AB. This bisector makes angle (180° - B)/2 with BC.\n# Similarly at C, it makes angle (180° - C)/2 with BC.\n#\n# The bisectors point AWAY from the triangle (outward). In triangle DBC,\n# the interior angles at B and C are the supplements:\n# angle DBC = 180° - (180° - B)/2 = 90° + B/2\n# angle DCB = 180° - (180° - C)/2 = 90° + C/2\n#\n# Sum of angles in triangle DBC:\n# angle BDC + (90° + B/2) + (90° + C/2) = 180°\n# angle BDC = 180° - 180° - (B + C)/2 = -(B + C)/2\n\nA = sp.symbols('A', positive=True)\n# Use B + C = 180 - A\nB = sp.symbols('B', positive=True)\nC = sp.symbols('C', positive=True)\n\n# angle BDC = -(B+C)/2\nangle_BDC = -(B + C)/2\n\n# Substitute C = 180 - A - B\nangle_BDC_in_A = angle_BDC.subs(C, 180 - A - B)\nangle_BDC_in_A = sp.simplify(angle_BDC_in_A)\nprint(\"angle BDC in terms of A and B:\", angle_BDC_in_A, \"degrees\")\n\n# This gives -(B + (180 - A))/2 = (A - 180 - B)/2, still depends on B.\n\n# Verify with numeric simulation of the actual construction\ndef simulate(A_deg, B_deg, C_deg):\n    import numpy as np\n    A, B, C = np.radians([A_deg, B_deg, C_deg])\n    \n    # Place vertices\n    # A at origin, B along x-axis\n    A_pt = np.array([0.0, 0.0])\n    B_pt = np.array([1.0, 0.0])\n    # C placed above\n    # angle at A is A_deg, angle at B is B_deg\n    # C is at intersection\n    # Side AB length 1. Angle at A between AB and AC.\n    # Direction from A to B is (1,0). Angle BAC = A.\n    # C direction from A makes angle A with AB.\n    # distance AC from law of sines: AC/sin(B) = AB/sin(C)\n    AC = np.sin(B_deg*np.pi/180)/np.sin(C_deg*np.pi/180)\n    C_pt = AC*np.array([np.cos(A), np.sin(A)])\n    \n    # Interior bisector directions (reference)\n    def interior_bisector(P, Q, R):\n        # bisector at P between sides PQ and PR\n        v1 = (Q - P)/np.linalg.norm(Q - P)\n        v2 = (R - P)/np.linalg.norm(R - P)\n        return v1 + v2\n    \n    ib_B = interior_bisector(B_pt, A_pt, C_pt)  # direction of interior bisector at B\n    ib_C = interior_bisector(C_pt, A_pt, B_pt)  # direction of interior bisector at C\n    \n    # Exterior bisectors are perpendicular to interior bisectors\n    def perp(v):\n        return np.array([-v[1], v[0]])\n    \n    # The exterior bisector at B: perpendicular to interior bisector\n    ex_B = perp(ib_B)\n    ex_C = perp(ib_C)\n    \n    # The exterior bisector at B passes through B, but which direction?\n    # The interior bisector points INTO the triangle (toward interior).\n    # The two perpendicular directions are both \"exterior\" bisectors.\n    # We need the one that bisects the exterior angle.\n    # Exterior angle bisector direction: rotate interior bisector by 90°\n    # Try both and find intersection\n    \n    # Parametrize line B: B_pt + t*ex_B\n    # Parametrize line C: C_pt + s*ex_C\n    # Solve for intersection\n    \n    # Build lines\n    def line_intersect(P1, d1, P2, d2):\n        # P1 + t*d1 = P2 + s*d2\n        A_mat = np.array([[d1[0], -d2[0]],[d1[1], -d2[1]]])\n        b_vec = P2 - P1\n        t, s = np.linalg.solve(A_mat, b_vec)\n        return P1 + t*d1\n    \n    # Try combinations\n    candidates = []\n    for eB in [ex_B, -ex_B]:\n        for eC in [ex_C, -ex_C]:\n            P = line_intersect(B_pt, eB, C_pt, eC)\n            # Compute angle BPC\n            v1 = P - B_pt\n            v2 = P - C_pt\n            cosang = np.dot(v1, v2)/(np.linalg.norm(v1)*np.linalg.norm(v2))\n            ang = np.degrees(np.arccos(np.clip(cosang, -1, 1)))\n            candidates.append(ang)\n    \n    return candidates\n\n# Test with specific triangle\nprint(\"\\nNumeric simulations (should give angle BDC):\")\nfor (A_deg, B_deg, C_deg) in [(60,70,50), (80,60,40), (50,80,50), (100,40,40), (90,45,45)]:\n    res = simulate(A_deg, B_deg, C_deg)\n    print(f\"A={A_deg}, B={B_deg}, C={C_deg}: candidates = {res}\")"}) - MainThread
