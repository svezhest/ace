onfirm formula: min_turns(k) = smallest m with sum of m largest >= k\ndef formula_min_turns(k, n):\n    m = 1\n    while True:\n        s = m*n - m*(m-1)//2\n        if s >= k:\n            return m\n        m += 1\n\nprint()\nfor n in [3, 4, 5]:\n    piles = list(range(1, n+1))\n    total = sum(piles)\n    ok = True\n    for k in range(1, total+1):\n        f = formula_min_turns(k, n)\n        g = greedy_min_turns(k, piles)\n        if f != g:\n            ok = False\n            print(f\"FORMULA MISMATCH n={n}, k={k}: {f} vs {g}\")\n            break\n    print(f\"n={n}: formula matches greedy? {ok}\")"}) - MainThread
