n    v = R - Q\n    t = (P - Q).dot(v) / (v.dot(v))\n    return Q + t*v\n\nX_num = foot_of_perp_num(D_num, B_num, C_num)\nY_num = foot_of_perp_num(E_num, B_num, C_num)\n\n# Vectors AX and AY\nAX_vec = X_num - A_num\nAY_vec = Y_num - A_num\n\n# Angle XAY\ncos_XAY = (AX_vec.dot(AY_vec)) / (sp.sqrt(AX_vec.dot(AX_vec)) * sp.sqrt(AY_vec.dot(AY_vec)))\nangle_XAY = sp.acos(cos_XAY)\nprint(f\"\\nAngle XAY = {sp.deg(angle_XAY)} degrees\")\nprint(f\"Angle XAY in radians = {angle_XAY}\")\n\n# Let me check: is angle XAY = 45°?\nprint(f\"cos(45°) = {sp.cos(sp.rad(45))}\")\nprint(f\"cos(XAY) = {cos_XAY}\")\n\n# If angle XAY = 45°:\n# XY² = AX² + AY² - 2*AX*AY*cos(45°)\n# AX = 48√2 * √2 = 96\n# AY = 52√2 * √2 = 104\n# Wait, that gives XY² = 96² + 104² - 2*96*104*cos(45°)\nXY2_formula = 96**2 + 104**2 - 2*96*104*sp.cos(sp.rad(45))\nprint(f\"\\nIf angle XAY = 45°: XY² = {sp.nsimplify(XY2_formula)}\")"}) - MainThread
