^2 + R^2 sin^2 t) = 576, u0 = a/R\n# a^2 (R^2 + R^2 sin^2 t) = 576 R^2  ... (II)\n# sin^2 t = 1 - cos^2 t = 1 - (x_F/R)^2 = 1 - ((a*289/72)/R)^2  [from cos t = x_F/R and x_F = a*289/72]\n# So R^2 + R^2 sin^2 t = 2R^2 - x_F^2 = 2R^2 - (a*289/72)^2\n# (II): a^2 (2R^2 - (a*289/72)^2) = 576 R^2\n#\n# From (A): a^2 = R^2 - 432.\n# Let me just solve numerically for R.\n\nfrom scipy.optimize import brentq\n\ndef f(R):\n    a2 = R**2 - 432\n    if a2 <= 0: return None\n    a = sqrt(a2)\n    xF = a * 289/72\n    val = a**2 * (2*R**2 - xF**2) - 576*R**2\n    return val\n\n# Search R\nRs = np.linspace(20, 200, 20000)\nvals = []\nfor R in Rs:\n    v = f(R)\n    vals.append(v if v is not None else -1e9)\nvals = np.array(vals)\n# find sign change\nidx = np.where(np.diff(np.sign(vals)) != 0)[0]\nprint(\"R candidates:\", Rs[idx][:10])\nfor R in Rs[idx][:10]:\n    print(\"R =\", R, \" f =\", f(R))"}) - MainThread
