norm(AC)**2)\n    print(\"t=|AB|-|AC|=\",np.linalg.norm(AB)-np.linalg.norm(AC))\n    print(\"Area=25-t^2/4=\",25-((np.linalg.norm(AB)-np.linalg.norm(AC))**2)/4)"}) - MainThread
