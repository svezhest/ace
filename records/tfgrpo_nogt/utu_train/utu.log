(3400 - 3000*sp.cos(A))\nAreaABC = 750*sp.sin(A)\nAreaAMN = sp.Rational(375,2)*sp.sin(A)\nAreaMBP = sp.Rational(225,2)*(50*sp.sin(A))/BC\nAreaNCP = sp.Rational(125,2)*(30*sp.sin(A))/BC\n\nAreaMNP = sp.simplify(AreaABC - AreaAMN - AreaMBP - AreaNCP)\nprint(\"AreaMNP symbolic:\", AreaMNP)"}) - MainThread
