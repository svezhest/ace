B,\" C=\",C)\nAB,AC=B-A,C-A\nprint(\"AB.AC=\",dot(AB,AC),\" angle(deg)=\",math.degrees(math.acos(max(dot(AB,AC),-1)/(np.linalg.norm(AB)*np.linalg.norm(AC))))\nprint(\"Area=\",0.5*abs(AB[0]*AC[1]-AB[1]*AC[0]))"}) - MainThread
