ntersects AB at F=(4,0) and CD at G=(1,12)=E.\n# FG^2 = (4-1)^2 + 12^2 = 9+144 = 153.\n#\n# The tension: is E=(1,12) \"outside ABCD\"?\n# E=(1,12) is on edge CD (boundary), NOT strictly outside.\n# E=(1,-12) is strictly outside.\n#\n# \"Outside ABCD\" most naturally means strictly outside.\n# So E=(1,-12), FG^2=145.\n#\n# This is the unique answer satisfying all conditions.\n#\n# Final answer: FG^2 = 145.\n\n# Final verification\nimport numpy as np\nA=np.array([0,0]); B=np.array([5,0]); C=np.array([5,12]); D=np.array([0,12])\nO=np.array([2.5,6])\nE=np.array([1,-12])\n\n# Distances\ndAB=abs(E[1]); dAD=abs(E[0])\nprint(f\"dist to AB={dAB}, dist to AD={dAD}\")\n\n# Acute check\nAE=E-A; AB=B-A; BE=E-B\nprint(\"acute at A:\", np.dot(AE,AB)>0, \"at B:\", np.dot(B-A, E-B)>0, \"at E:\", np.dot(A-E,B-E)>0)\n\n# Outside\ninside = (0<=E[0]<=5) and (0<=E[1]<=12)\nprint(\"inside ABCD:\", inside, \"-> outside:\", not inside)\n\n# Line EO intersections\ntF = -E[1]/(O[1]-E[1]); tG=(12-E[1])/(O[1]-E[1])\nxF=E[0]+tF*(O[0]-E[0]); xG=E[0]+tG*(O[0]-E[0])\nprint(f\"F=({xF},0), G=({xG},12)\")\nFG2=(xF-xG)**2+(0-12)**2\nprint(f\"FG^2 = {FG2}\")\n\n# Area check\nimport numpy as np\ndef poly_area(pts):\n    x=[p[0] for p in pts]; y=[p[1] for p in pts]\n    return 0.5*abs(sum(x[i]*(y[(i+1)%len(pts)]-y[(i-1)%len(pts)]) for i in range(len(pts))))\nquad = [(0,0),(2,0),(3,12),(0,12)]  # A, F, G, D\nprint(f\"Area of AFGD: {poly_area(quad)}, total: {poly_area([(0,0),(5,0),(5,12),(0,12)])}\")"}) - MainThread
