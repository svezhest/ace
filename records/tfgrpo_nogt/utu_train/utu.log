   b,c = res.x\n    B = 5*np.array([np.cos(b), np.sin(b)]); C = 5*np.array([np.cos(c), np.sin(c)])\n    AB = B-A; AC = C-A\n    area = 0.5*abs(np.cross(AB,AC))\n    ang = np.dot(AB,AC)/(np.linalg.norm(AB)*np.linalg.norm(AC))\n    costheta = np.arccos(np.clip(ang,-1,1))\n    if best is None or area > best[0]:\n        best = (area, b, c, B, C, costheta)\n\narea, b, c, B, C, costheta = best\nprint(\"\\nOptimization best area =\", area)\nprint(\"B =\", B, \" C =\", C)\nprint(\"angle BAC (deg) =\", np.degrees(np.arccos(costheta)))\nprint(\"costheta =\", costheta)\nAB = np.linalg.norm(B-A); AC = np.linalg.norm(C-A)\nprint(\"AB =\", AB, \" AC =\", AC)"}) - MainThread
