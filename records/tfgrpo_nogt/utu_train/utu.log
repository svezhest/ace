i - sum_{not in S} (i - i//2) = 0\n# => sum_{i in S} i = sum_{not in S} ceil(i/2)\n# cost = |S| + sum_{not in S}(i//2+1)\n\n# Let's just brute force greedily / DP.\n# cost = number of fully-removed + sum over reduced of (floor(i/2)+1)\n# minimized subject to removed==k.\n\n# Since we can choose any subset, let's do a DP over achievable removed values.\n# But n=2020, values large. Instead note symmetry.\n\n# Let me just verify the claim that answer = 1011 with a smaller construction reasoning,\n# and also do a DP for small n to find pattern.\n\ndef min_cost_dp(n, k):\n    # dp[d] = min cost to remove exactly d coins from piles 1..n\n    INF = float('inf')\n    dp = [INF]*(k+1)\n    dp[0] = 0\n    for i in range(1, n+1):\n        c1 = i\n        c2 = i//2 + 1\n        # options: cost1 remove i, cost2 remove i//2\n        # iterate carefully\n        new = dp[:]\n        # choose cost1\n        for d in range(k, i-1, -1):\n            if dp[d-i] < INF:\n                new[d] = min(new[d], dp[d-i]+c1)\n        # choose cost2\n        for d in range(k, i//2-1, -1):\n            if dp[d-i//2] < INF:\n                new[d] = min(new[d], dp[d-i//2]+c2)\n        dp = new\n    return dp[k]\n\nfor n in [3,4,5,6,7,10,20]:\n    k = n*(n+1)//2\n    print(n, \"min cost =\", min_cost_dp(n, k))"}) - MainThread
