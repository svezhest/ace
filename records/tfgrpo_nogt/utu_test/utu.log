= np.linspace(0, 1, N)\ny1 = F(xs)\n\nys = np.linspace(0, 1, N)\nx2 = G(ys)\n\n# Count intersections\ncount = 0\nfor i in range(N-1):\n    # Segment 1: from (xs[i], y1[i]) to (xs[i+1], y1[i+1])\n    p1 = (xs[i], y1[i])\n    p2 = (xs[i+1], y1[i+1])\n    for j in range(N-1):\n        # Segment 2: from (x2[j], ys[j]) to (x2[j+1], ys[j+1])\n        q1 = (x2[j], ys[j])\n        q2 = (x2[j+1], ys[j+1])\n        # Check if segments intersect\n        # Using the cross product method\n        def cross(o, a, b):\n            return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])\n        d1 = cross(p1, p2, q1)\n        d2 = cross(p1, p2, q2)\n        d3 = cross(q1, q2, p1)\n        d4 = cross(q1, q2, p2)\n        if ((d1>0 and d2<0) or (d1<0 and d2>0)) and ((d3>0 and d4<0) or (d3<0 and d4>0)):\n            count += 1\nprint(f\"Number of intersections (O(N^2) method): {count}\")"}) - MainThread
