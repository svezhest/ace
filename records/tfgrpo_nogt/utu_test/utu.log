ign_changes = 0\ncrossings = []\nfor i in range(1, len(xs)):\n    if Hvals[i] * Hvals[i-1] < 0:\n        sign_changes += 1\n        crossings.append(xs[i])\nprint(f\"Sign changes of H over [0,1]: {sign_changes}\")\nprint(f\"First 20 crossings: {[round(c,4) for c in crossings[:20]]}\")\nprint(f\"Last 20 crossings: {[round(c,4) for c in crossings[-20:]]}\")"}) - MainThread
